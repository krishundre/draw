# Copy this file to .env.local for local overrides (never commit real secrets).

# --- Client (build-time, exposed to the browser — no secrets here) ---

# WebSocket URL for the optional real-time collaboration server (see server/index.js).
# Leave unset / point at your own collab server if you're running one.
VITE_COLLAB_WS_URL=ws://localhost:1234

# --- Server (Vercel serverless function: api/feedback.ts — kept secret, never exposed to the browser) ---

# API key from https://resend.com (Dashboard → API Keys). Required for the feedback form to send email.
RESEND_API_KEY=re_your_api_key_here

# Address the feedback form emails FROM. Must be on a domain you've verified in Resend,
# or use Resend's shared test sender until you verify your own domain.
RESEND_FROM_EMAIL="DrawBoard Feedback <onboarding@resend.dev>"

# Address feedback emails are sent TO.
FEEDBACK_TO_EMAIL=chef@designpav.in
