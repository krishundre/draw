# Real-time collaboration is off by default (no VITE_COLLAB_WS_URL set) — the
# public draw.designpav.in deployment doesn't run the collab relay server
# (see server/index.js and the README's "Real-time collaboration" section).
#
# To enable it locally: copy the line below into .env.local (gitignored) and
# run `npm run server` alongside `npm run dev`.
# VITE_COLLAB_WS_URL=ws://localhost:1234
